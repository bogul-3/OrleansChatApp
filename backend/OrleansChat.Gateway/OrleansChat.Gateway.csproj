<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
		<NoWarn>$(NoWarn);CS0200</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Orleans.Client" Version="10.2.1" />
		<PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" Version="10.2.1" />
		<PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" Version="10.2.1" />
		<PackageReference Include="Npgsql" Version="9.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OrleansChat.Shared\OrleansChat.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="**/OpenApiXmlCommentSupport.generated.cs" />
		<None Include="**/OpenApiXmlCommentSupport.generated.cs" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Controllers\" />
	</ItemGroup>

</Project>